# Copy to .env (same directory, gitignored). Loaded automatically at
# orchestrator startup; file values take precedence, keys absent or empty
# here fall back to the exported environment, then orchestrator.toml.
# CLI flags > named profile > these env values > orchestrator.toml.

# ORCH_BACKEND=cc-codex                # cursor|cc-codex; overrides the committed default
# ORCH_MAX_SESSIONS=40
# ORCH_CONTEXT_BUDGET=200000

# --- cursor backend (--backend cursor) ---
CURSOR_API_KEY=
# ORCH_DEV_MODEL=claude-fable-5        # SDK base model ids
# ORCH_REVIEW_MODEL=gpt-5.5
# ORCH_CURSOR_DEV_EFFORT=high          # claude effort axis low..max
# ORCH_CURSOR_REVIEW_EFFORT=medium     # none/low/medium/high/xhigh; xhigh maps to Cursor extra-high

# --- cc-codex backend (--backend cc-codex, default) ---
# Auth comes from each CLI's own login (claude /login, codex login) — no
# keys here.
# ORCH_CC_DEV_AGENT=claude             # claude|codex
# ORCH_CC_MODEL=claude-fable-5         # claude --model (or alias: fable)
# ORCH_CC_EFFORT=max                   # claude --effort (low..max)
# ORCH_CODEX_DEV_MODEL=gpt-5.5         # codex -m when --dev-agent codex
# ORCH_CODEX_DEV_EFFORT=xhigh
# ORCH_CODEX_MODEL=gpt-5.5             # codex -m
# ORCH_CODEX_EFFORT=xhigh              # codex model_reasoning_effort
# ORCH_CODEX_SANDBOX=workspace-write   # codex -s (read-only|workspace-write|danger-full-access)
