# Copy to .env (same directory, gitignored). Loaded automatically at
# orchestrator startup; file values take precedence, keys absent or empty
# here fall back to the exported environment.

# --- cursor backend (--backend cursor, default) ---
CURSOR_API_KEY=
# ORCH_DEV_MODEL=claude-fable-5        # SDK base model ids
# ORCH_REVIEW_MODEL=gpt-5.5
# ORCH_CURSOR_DEV_EFFORT=              # claude effort axis low..max; empty = catalog default (high)
# ORCH_CURSOR_REVIEW_EFFORT=           # none/low/medium/high/xhigh (xhigh auto-maps to cursor's 'extra-high'); empty = catalog default (medium)

# --- cc-codex backend (--backend cc-codex) ---
# Auth comes from each CLI's own login (claude /login, codex login) — no
# keys here.
# ORCH_CC_MODEL=fable-5                # claude --model
# ORCH_CC_EFFORT=max                   # claude --effort (low..max)
# ORCH_CODEX_MODEL=gpt-5.5             # codex -m
# ORCH_CODEX_EFFORT=xhigh              # codex model_reasoning_effort
# ORCH_CODEX_SANDBOX=workspace-write   # codex -s (read-only|workspace-write|danger-full-access)
