#!/usr/bin/env sh
set -eu

# shellcheck disable=SC1007  # `CDPATH=` empties CDPATH for this cd only, so a
# user's CDPATH cannot make cd print a different directory. Not a typo.
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROG_NAME=${0##*/}

if [ -n "${PYTHONPATH:-}" ]; then
  export PYTHONPATH="$SCRIPT_DIR:$PYTHONPATH"
else
  export PYTHONPATH="$SCRIPT_DIR"
fi

export AI_NATIVE_DEPLOYMENT_PROG="${AI_NATIVE_DEPLOYMENT_PROG:-$PROG_NAME}"
exec python -m ai_native_deployment.cli "$@"
